{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aNotate",
  "version": "0.1.0",
  "identifier": "com.wavnotes.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/provision-decoder.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/provision-decoder.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "aNotate", "width": 1100, "height": 760, "theme": "Light" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$RESOURCE/resources/smoke.wav"] }
    }
  },
  "bundle": { "active": true, "targets": "all", "macOS": { "signingIdentity": "-" }, "resources": { "resources/smoke.wav": "resources/smoke.wav", "resources/ffmpeg": "resources/ffmpeg", "../third-party/ffmpeg/": "third-party/ffmpeg/", "../scripts/provision-decoder.sh": "third-party/ffmpeg/provision-decoder.sh" } }
}
